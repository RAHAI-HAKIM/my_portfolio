---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import Pending from "../components/Pending.astro";
import ProjectCard from "../components/ProjectCard.astro";
import StatusBadge from "../components/StatusBadge.astro";
import GradeTrend from "../components/GradeTrend.astro";
import Skills from "../components/Skills.astro";
import CopyEmail from "../components/CopyEmail.astro";
import { profile, cv } from "../lib/profile";

const projects = (await getCollection("projects")).sort((a, b) => a.data.order - b.data.order);
const featured = projects.filter((p) => p.data.featured);
const more = projects.filter((p) => !p.data.featured);

// The family name is written in capitals in the data ("RAHAI"); running text reads better as "Rahai".
const fullName = profile.name.replace(/\b([A-Z])([A-Z]+)\b/g, (_, a: string, b: string) => a + b.toLowerCase());

const description = `I am an AI engineering student at ENSIA who builds optimization and decision-support systems for real businesses. Case studies, CV and contact.`;

const schema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: profile.name,
  alternateName: profile.displayName,
  url: Astro.site?.href,
  email: `mailto:${profile.email}`,
  jobTitle: profile.title,
  description: profile.positioning,
  address: { "@type": "PostalAddress", addressLocality: "Sougueur", addressRegion: "Tiaret", addressCountry: "DZ" },
  alumniOf: { "@type": "CollegeOrUniversity", name: "ENSIA, National School of Artificial Intelligence" },
  knowsLanguage: ["ar", "en", "fr"],
  sameAs: [profile.links.github, profile.links.linkedin],
};
---

<Base title={`${profile.displayName}, optimization and decision-support systems`} description={description} schema={schema}>
  <div class="page">
    <section class:list={["hero", { "has-portrait": profile.portrait }]} aria-labelledby="positioning">
      <div class="hero-text">
        <h1 id="positioning" class="rise">{profile.positioning.replaceAll("-", "‑")}</h1>
        <p class="who rise" style="--i: 1">
          I am an {profile.title} at ENSIA, working in {profile.focus.toLowerCase()}. Based in {profile.location}.
        </p>
        {
          profile.about ? (
            <p class="about rise" style="--i: 1">{profile.about}</p>
          ) : (
            <div class="rise" style="--i: 1">
              <Pending>An about paragraph, 3 to 4 sentences in Hakim's own words.</Pending>
            </div>
          )
        }
        <ul class="status rise" style="--i: 2" aria-label="Current status">
          {profile.status.map((item) => <li>{item}</li>)}
        </ul>
        <div class="actions rise" style="--i: 3">
          <a class="button primary" href="#work">View work</a>
          {
            cv.en ? (
              <a class="button" href={cv.en} download>
                <Icon name="download" size={18} />
                Download CV
              </a>
            ) : (
              <Pending inline>CV download, once the PDF is in public/cv</Pending>
            )
          }
          <span class="socials">
            <a class="icon-link" href={profile.links.github} aria-label="GitHub profile" rel="me noopener">
              <Icon name="github" />
            </a>
            <a class="icon-link" href={profile.links.linkedin} aria-label="LinkedIn profile" rel="me noopener">
              <Icon name="linkedin" />
            </a>
          </span>
        </div>
      </div>
      {
        profile.portrait && (
          <img class="portrait rise" style="--i: 2" src={profile.portrait} alt={`Portrait of ${profile.displayName}`} width="480" height="600" />
        )
      }
    </section>

    <section class="band" id="work" aria-labelledby="work-h">
      <h2 id="work-h">Selected work</h2>
      <div class="band-body cards">
        {featured.map((project, i) => <ProjectCard project={project} lead={i === 0} />)}
      </div>
    </section>

    <section class="band" id="more-work" aria-labelledby="more-h">
      <h2 id="more-h">More work</h2>
      <ul class="band-body more">
        {
          more.map(({ data }) => (
            <li>
              <h3>{data.title}</h3>
              <p class="tagline">{data.tagline}</p>
              <p class="meta small muted">
                {data.role}, team of {data.team}
              </p>
              <StatusBadge status={data.status} note={data.statusNote} />
            </li>
          ))
        }
      </ul>
    </section>

    <section class="band" id="leadership" aria-labelledby="lead-h">
      <h2 id="lead-h">Leadership</h2>
      <ol class="band-body timeline">
        {
          profile.leadership.map((entry) => (
            <li>
              <p class="period num">{entry.period}</p>
              <div class="entry">
                <h3>{entry.role}</h3>
                {entry.org && <p class="org muted">{entry.org}</p>}
                {entry.lines.map((line) => <p class="line">{line}</p>)}
              </div>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="band" id="education" aria-labelledby="edu-h">
      <h2 id="edu-h">Education</h2>
      <ol class="band-body timeline">
        {
          profile.education.map((entry) => (
            <li>
              <p class="period num">{entry.period}</p>
              <div class="entry">
                <h3>{entry.school}</h3>
                {entry.degree && <p class="org muted">{entry.degree}</p>}
                <p class="line">{entry.note}</p>
                {entry.coursework.length > 0 && <p class="line muted small">Coursework: {entry.coursework.join(", ")}.</p>}
                {entry.grades.length > 1 && <div class="chart"><GradeTrend grades={entry.grades} /></div>}
              </div>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="band" id="skills" aria-labelledby="skills-h">
      <h2 id="skills-h">Skills</h2>
      <div class="band-body">
        <Skills />
      </div>
    </section>

    <section class="band" id="contact" aria-labelledby="contact-h">
      <h2 id="contact-h">Contact</h2>
      <div class="band-body contact">
        <p class="invite">
          Hiring for a 2027 internship, reviewing an application, or curious about Waymark? Email is the fastest way
          to reach me.
        </p>
        <CopyEmail />
        <ul class="links">
          <li>
            <a href={profile.links.linkedin} rel="me noopener">LinkedIn</a>
          </li>
          <li>
            <a href={profile.links.github} rel="me noopener">GitHub</a>
          </li>
          {cv.en && <li><a href={cv.en} download>CV in English (PDF)</a></li>}
          {cv.fr && <li><a href={cv.fr} download>CV en français (PDF)</a></li>}
        </ul>
        {(!cv.en || !cv.fr) && <Pending>CV downloads (EN and FR). Add the PDFs to public/cv and the links appear here.</Pending>}
      </div>
    </section>
  </div>
</Base>

<style>
  /* Hero ---------------------------------------------------------- */
  .hero {
    display: grid;
    gap: var(--s-5);
    padding-block: clamp(3rem, 9vw, 7rem) clamp(3.5rem, 8vw, 6rem);
  }

  .hero-text {
    display: grid;
    gap: var(--s-3);
    justify-items: start;
  }

  h1 {
    max-width: 18ch;
    font-size: var(--step-5);
    font-weight: 350;
    line-height: 1.04;
    letter-spacing: -0.028em;
  }

  .who,
  .about {
    max-width: 34rem;
    font-size: var(--step-2);
    line-height: 1.5;
    color: var(--ink-2);
  }

  .about {
    font-size: var(--step-1);
  }

  .status {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem 1.5rem;
    font-size: var(--step-0);
    font-weight: 500;
  }

  .status li {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .status li::before {
    content: "";
    width: 0.4375rem;
    height: 0.4375rem;
    border-radius: 50%;
    background: var(--accent);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    margin-top: var(--s-1);
  }

  .socials {
    display: inline-flex;
    margin-left: 0.25rem;
  }

  .portrait {
    width: min(100%, 20rem);
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: var(--radius-m);
  }

  @media (min-width: 60rem) {
    .hero.has-portrait {
      grid-template-columns: minmax(0, 1fr) 20rem;
      align-items: end;
    }
  }

  /* Selected work ------------------------------------------------- */
  .cards {
    display: grid;
    gap: var(--s-5) var(--s-4);
  }

  @media (min-width: 52rem) {
    .cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .cards > :global(.lead) {
      grid-column: 1 / -1;
    }
  }

  /* More work ----------------------------------------------------- */
  .more li {
    display: grid;
    gap: 0.25rem var(--s-3);
    padding-block: var(--s-3);
    border-top: 1px solid var(--rule);
  }

  .more li:first-child {
    padding-top: 0;
    border-top: 0;
  }

  .more h3 {
    font-size: var(--step-3);
  }

  .more .tagline {
    max-width: var(--measure);
  }

  @media (min-width: 46rem) {
    .more li {
      grid-template-columns: 9rem minmax(0, 1fr) auto;
      align-items: baseline;
    }

    .more .meta {
      grid-column: 2;
    }

    .more li > :global(.badge) {
      grid-column: 3;
      grid-row: 1;
    }
  }

  /* Timelines ----------------------------------------------------- */
  .timeline {
    display: grid;
    gap: var(--s-4);
  }

  .timeline li {
    display: grid;
    gap: 0.25rem var(--s-3);
  }

  .period {
    color: var(--ink-3);
    padding-top: 0.3em;
  }

  .entry {
    display: grid;
    gap: 0.375rem;
    max-width: var(--measure);
  }

  .entry h3 {
    font-size: var(--step-3);
  }

  .entry .org {
    font-size: var(--step-0);
  }

  .entry .line {
    margin-top: 0.25rem;
  }

  .chart {
    margin-top: var(--s-2);
  }

  @media (min-width: 46rem) {
    .timeline li {
      grid-template-columns: 9rem minmax(0, 1fr);
    }
  }

  /* Contact ------------------------------------------------------- */
  .contact {
    display: grid;
    gap: var(--s-3);
  }

  .invite {
    max-width: 32rem;
    font-size: var(--step-2);
    line-height: 1.45;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem var(--s-3);
  }

  .links a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
  }
</style>
