---
// A small hand-drawn icon set: 20px grid, 1.5px strokes, round joins.
// Kept deliberately tiny. Add a path here before reaching for an icon pack.
interface Props {
  name: "github" | "linkedin" | "sun" | "moon" | "download" | "copy" | "check" | "arrow" | "back" | "out" | "mail";
  size?: number;
}
const { name, size = 20 } = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 20 20"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {name === "github" && (
    <path
      fill="currentColor"
      stroke="none"
      transform="translate(1 1) scale(1.125)"
      d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"
    />
  )}
  {name === "linkedin" && (
    <>
      <rect x="2.25" y="2.25" width="15.5" height="15.5" rx="3" />
      <path d="M6.25 9v5M6.25 6.1v.05M9.75 14V9M9.75 11.4c0-1.5 1-2.4 2.2-2.4s1.8.8 1.8 2.2V14" />
    </>
  )}
  {name === "sun" && (
    <>
      <circle cx="10" cy="10" r="3.25" />
      <path d="M10 2.5v1.75M10 15.75v1.75M2.5 10h1.75M15.75 10h1.75M4.7 4.7l1.25 1.25M14.05 14.05l1.25 1.25M4.7 15.3l1.25-1.25M14.05 5.95l1.25-1.25" />
    </>
  )}
  {name === "moon" && <path d="M16.5 11.6A6.75 6.75 0 0 1 8.4 3.5a6.75 6.75 0 1 0 8.1 8.1Z" />}
  {name === "download" && <path d="M10 3v9.5M6 9l4 3.75L14 9M4 16.5h12" />}
  {name === "copy" && (
    <>
      <rect x="7" y="7" width="10" height="10" rx="2" />
      <path d="M13 7V5a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2h2" />
    </>
  )}
  {name === "check" && <path d="m4 10.5 4 4 8-9" />}
  {name === "arrow" && <path d="M4 10h12M11.5 5.5 16 10l-4.5 4.5" />}
  {name === "back" && <path d="M16 10H4M8.5 5.5 4 10l4.5 4.5" />}
  {name === "out" && <path d="M7 13 14.5 5.5M8 5.5h6.5V12" />}
  {name === "mail" && (
    <>
      <rect x="2.5" y="4.5" width="15" height="11" rx="2" />
      <path d="m3 6 7 5 7-5" />
    </>
  )}
</svg>
