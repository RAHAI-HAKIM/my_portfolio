---
import ThemeToggle from "./ThemeToggle.astro";
import { profile } from "../lib/profile";

const links = [
  { href: "/#work", label: "Work", keep: true },
  { href: "/#leadership", label: "Leadership", keep: false },
  { href: "/#education", label: "Education", keep: false },
  { href: "/#skills", label: "Skills", keep: false },
  { href: "/#contact", label: "Contact", keep: true },
];
---

<header class="site-header">
  <div class="page bar">
    <a class="wordmark" href="/" aria-label={`${profile.displayName}, home`}>{profile.displayName}</a>
    <nav aria-label="Main">
      <ul>
        {
          links.map((link) => (
            <li class:list={{ optional: !link.keep }}>
              <a href={link.href}>{link.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>
    <ThemeToggle />
  </div>
</header>

<style>
  .bar {
    display: flex;
    align-items: center;
    gap: var(--s-2);
    min-height: 4.5rem;
  }

  .wordmark {
    margin-right: auto;
    font-family: var(--serif);
    font-size: 1.375rem;
    font-weight: 500;
    letter-spacing: -0.015em;
    text-decoration: none;
    white-space: nowrap;
    view-transition-name: wordmark;
  }

  ul {
    display: flex;
    gap: 0.25rem;
  }

  nav a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding-inline: 0.625rem;
    font-size: var(--step-0);
    color: var(--ink-2);
    text-decoration: none;
  }

  nav a:hover {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: var(--rule-strong);
  }

  .optional {
    display: none;
  }

  @media (min-width: 44rem) {
    .optional {
      display: block;
    }
  }
</style>
